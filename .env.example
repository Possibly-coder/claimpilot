# Leave empty to use the rule-based extractor.
ANTHROPIC_API_KEY=
CLAIMPILOT_MODEL=claude-haiku-5-5
# USD per million tokens, used for the cost-per-claim metric.
CLAIMPILOT_PRICE_IN_PER_MTOK=0.10
CLAIMPILOT_PRICE_OUT_PER_MTOK=0.50

DATABASE_URL=sqlite:///./claimpilot.db
# Empty = no write-back to the legacy claims system.
LEGACY_API_URL=
CLAIMPILOT_AUTO_LIMIT=5000
CLAIMPILOT_MIN_CONFIDENCE=0.8
